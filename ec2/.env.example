# =============================================================================
# EC2 Environment Variables — copy to ~/app/services/.env on the EC2 instance
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your-service-role-key

# --- AWS S3 ---
AWS_KEY_ID=your-aws-access-key-id
AWS_SECRET=your-aws-secret-access-key
S3_BUCKET=yoav-radio-recordings
S3_REGION=us-east-1

# --- RunPod (for pipeline trigger) ---
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_DIARIZE_ENDPOINT=your-diarize-endpoint-id

# --- Embedding models (defaults are fine) ---
# MODEL_EMBED=intfloat/multilingual-e5-large
# EMBED_SERVICE_URL=http://embed:8000  (set by docker-compose)
