# =============================================================================
# RunPod Diarization Environment — set in RunPod endpoint config
# =============================================================================

# --- AWS S3 ---
AWS_KEY_ID=your-aws-access-key-id
AWS_SECRET=your-aws-secret-access-key
S3_BUCKET=yoav-radio-recordings
S3_REGION=us-east-1

# --- HuggingFace (pyannote model access) ---
# Request access: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your-huggingface-token
