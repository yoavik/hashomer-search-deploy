# =============================================================================
# Pipeline Environment — reads from project root .env on EC2
# =============================================================================

# --- RunPod endpoints ---
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_DIARIZE_ENDPOINT=your-diarize-endpoint-id

# --- Local services ---
INDEX_SERVICE_URL=http://localhost:8003

# --- AWS S3 ---
AWS_KEY_ID=your-aws-access-key-id
AWS_SECRET=your-aws-secret-access-key
S3_BUCKET=yoav-radio-recordings
S3_REGION=us-east-1
